# ZAP STATION — variáveis de ambiente (somente nomes e valores de exemplo).
# Copie para .env (ignorado pelo Git) e preencha. NUNCA versione valores reais.

# ---------------------------------------------------------------------------
# APLICATIVO (públicas por design; entram no APK via --dart-define)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
APP_ENV=dev

# Exemplo de uso:
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY \
#     --dart-define=APP_ENV=$APP_ENV

# ---------------------------------------------------------------------------
# BACKEND (SECRETAS — somente no Supabase/Edge Functions, jamais no app)
# Configure com: supabase secrets set NOME=valor
# ---------------------------------------------------------------------------
# Chave administrativa do Supabase. Já existe no runtime das Edge Functions;
# listada aqui só para documentar que NUNCA vai para o cliente.
# SUPABASE_SERVICE_ROLE_KEY=

# Fase 7 — chamadas (LiveKit Cloud ou servidor próprio)
LIVEKIT_URL=wss://seu-projeto.livekit.cloud
LIVEKIT_API_KEY=exemplo-api-key
LIVEKIT_API_SECRET=exemplo-api-secret

# Fase 6 — notificações push (JSON da conta de serviço do Firebase, em uma linha)
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"exemplo"}

# Provedor de SMS (configurado no painel do Supabase Auth; exemplo para Twilio)
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=MGxxxxxxxxxxxxxxxx
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=exemplo-token
