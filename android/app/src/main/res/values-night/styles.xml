<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema exibido enquanto o Flutter inicializa: fundo grafite, sem flash branco. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/zap_background</item>
        <item name="android:navigationBarColor">@color/zap_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/zap_background</item>
    </style>
</resources>
